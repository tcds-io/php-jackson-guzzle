{
  "name": "tcds-io/php-jackson-guzzle",
  "description": "A Guzzle plugin that parses request objects into json and response into objects",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4",
    "guzzlehttp/guzzle": "^7.0|^8.0",
    "tcds-io/php-jackson": "^1.0.0"
  },
  "autoload": {
    "psr-4": {
      "Tcds\\Io\\Jackson\\Guzzle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\Tcds\\Io\\Jackson\\Guzzle\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  }
}
